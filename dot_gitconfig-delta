# Git configuration for delta (https://github.com/dandavison/delta)
# Managed by chezmoi. To enable, add the following to your ~/.gitconfig:
#
#   [include]
#       path = ~/.gitconfig-delta

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
